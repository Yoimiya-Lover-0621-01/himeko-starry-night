{
    "name":  "@local/star-wallpaper",
    "version":  "1.0.0",
    "private":  true,
    "description":  "姬子的星月夜 · DeepSeek Harness 星云壁纸 + 莫奈液态玻璃主题",
    "type":  "module",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-layout"
                                          ]
                           }
            },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "assets/nebula.jpg",
                  "assets/boot.jpg",
                  "assets/brand-lockup.svg",
                  "assets/whale-tail.png",
                  "assets/whale-tail-still.svg",
                  "README.md"
              ],
    "license":  "MIT",
    "keywords":  [
                     "deepseek",
                     "deepseek-harness",
                     "dsh",
                     "theme",
                     "wallpaper",
                     "liquid-glass",
                     "plugin"
                 ],
    "homepage":  "https://github.com/\u003cyour-username\u003e/himeko-starry-night#readme",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/\u003cyour-username\u003e/himeko-starry-night.git"
                   }
}